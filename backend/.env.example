APP_NAME=HBMS API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Local Docker replica set:
# MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
# Atlas:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/hbms?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/hbms?retryWrites=true&w=majority
MONGODB_DATABASE=hbms

JWT_SECRET_KEY=change-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Mistral (required for RAG embed/chat)
MISTRAL_API_KEY=
MISTRAL_EMBED_MODEL=mistral-embed
MISTRAL_CHAT_MODEL=mistral-small-latest

# Cron for CONFIRMED -> COMPLETED after check-out (standard 5-field crontab, UTC)
BOOKING_COMPLETION_CRON=0 * * * *
